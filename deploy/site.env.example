# Copy to deploy/site.env (ignored by git) and fill in. deploy.sh reads it.
TARGET=debian@203.0.113.10        # the web server, over ssh
PROXY_IP=203.0.113.1              # the reverse proxy in front of it
MAIL_IP=203.0.113.25              # the mail server the site sends through
MAIL_TLS_NAME=mail.example.org    # the name on that server's certificate
LLM_IP=203.0.113.30               # the help bubble's language model
BUGS_API_IP=                      # optional: the Discord bot's API
RAYE_PUBLISH=/srv/publish/release   # release notes, from the iso publish tools
RAYE_DISCORD_TEXTS=discord-texts.py  # the Discord announcement texts
