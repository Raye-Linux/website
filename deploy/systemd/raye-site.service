[Unit]
Description=rayelinux.com signup backend
Documentation=file:///opt/raye-site/README.md
After=network.target

[Service]
Type=simple
User=raye-site
DynamicUser=yes
StateDirectory=raye-site
StateDirectoryMode=0700
# every file of /etc/raye-site (root only) becomes a credential named
# smtp_<file>; a missing smtp.env is fine, mail waits in the queue, and a
# missing bug-webhook only turns the "Report a bug" form off
LoadCredential=smtp:/etc/raye-site
Environment=RAYE_SITE_URL=https://www.rayelinux.com
Environment=SMTP_TLS_NAME=@MAIL_TLS_NAME@
# the help bubble: the language model, on our own network
Environment=RAYE_SUPPORT_OLLAMA_URL=http://@LLM_IP@:11434
Environment=RAYE_SUPPORT_MODEL=TechorayeAI:latest
# the #bugs topics, read from the Discord bot's API. Off until it serves
# /api/public/raye/bugs; then uncomment and add its address below.
#Environment=RAYE_BUGS_API_URL=http://@BUGS_API_IP@:3000
#Environment=RAYE_BUGS_GUILD=1570836408745074770
ExecStart=/usr/bin/python3 -E -s -B /opt/raye-site/backend/raye-site-server
Restart=on-failure
RestartSec=5
UMask=0077

NoNewPrivileges=yes
KeyringMode=private
PrivateMounts=yes
# nothing may be executed but the interpreter and its libraries
NoExecPaths=/
ExecPaths=/usr/bin/python3.13 /usr/lib /usr/lib64
CapabilityBoundingSet=
AmbientCapabilities=
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
InaccessiblePaths=-/etc/raye-site
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# loopback for nginx, the mail server, the model, and Discord's API (on
# Cloudflare, 162.159.128.0/17) for bug reports; nothing else
IPAddressDeny=any
IPAddressAllow=localhost @MAIL_IP@ @LLM_IP@ 162.159.128.0/17
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
